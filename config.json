{
  "llm": {
    "temperature": 0.8,
    "max_tokens": 1024,
    "fallback": {
      "max_errors": 2,
      "cooldown_seconds": 120,
      "probe_timeout_seconds": 5
    },
    "enable_thinking": false
  },
  "memory": {
    "max_turns_short_term": 12,
    "recall_top_k": 5,
    "portrait_tag_limit": 20,
    "profile_confidence_threshold": 0.6,
    "persona_decay_days": 14,
    "diary_max_entries": 30,
    "session_update_interval": 5,
    "max_sessions": 8
  },
  "proactive": {
    "idle_minutes": 30
  },
  "tools": {
    "max_retry": 2,
    "max_tool_loop_rounds": 4
  },
  "personality": {
    "quirk_rate": 0.12
  },
  "thinking": {
    "enabled": true,
    "char_threshold": 60,
    "never_on_comfort": true,
    "never_on_emotions": ["sad", "angry", "委屈"],
    "force_if_last_poor": true
  },
  "expression": {
    "minimal_input_chars": 40,
    "minimal_allowlist": ["...", "。。。", "？", "？？", "！", "!!", "6", "666",
                          "神了", "不是哥们", "wdf", "哈", "哇", "切", "嗯", "哦", "哼"],
    "reaction_tag": "@r",
    "long_input_chars": 60,
    "long_input_require_split": true,
    "force_cut_chars": 40
  },
  "log": {
    "level": "INFO"
  }
}
