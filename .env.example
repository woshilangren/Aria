# 复制本文件为 .env 后填入真实值；.env 严禁提交到 git
# 变量名和 config/settings.py 里读的一一对应，别乱改名

# ===== 主 LLM（与下面的语音/向量/画图 key 是独立变量）=====
# 主 LLM 现为 claude-sonnet-5 走 nonelinear 代理（OpenAI 兼容 `/v1` 端点）。
# 与下面百炼（DashScope）的一把 key 通吃无关——换主模型供应商时**不影响**语音/向量/画图。
# 代码侧按模型家族分发参数（tools/llm_client._is_qwen），enable_thinking 仅发给 Qwen 家族，
# 对 Claude 发会 400 然后全切到备用，所以默认留空即可。
LLM_API_KEY=your-nonelinear-api-key
LLM_BASE_URL=https://api.nonelinear.com/v1
LLM_MODEL=claude-sonnet-5
# 模型支不支持工具调用（function calling），不支持会自动走 LLM 规划和规则表兜底
LLM_SUPPORTS_TOOL_CALL=true

# ===== 百炼（阿里云 DashScope）一把 key 通吃 =====
# ASR / TTS / Realtime / 图像 / 向量 全走百炼，这几行 key 填同一个即可

# 降级备用 LLM：主模型连不上或连续报错时自动切它，平常不碰
LLM_FALLBACK_API_KEY=your-glm-api-key
LLM_FALLBACK_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_FALLBACK_MODEL=glm-5.3-flash

# 语音识别：qwen-audio-3.0-asr-flash-streaming，走 dashscope SDK（整段音频一次转）
# SDK 不吃 BASE_URL，这个字段保留但已不使用，留空即可
ASR_API_KEY=your-dashscope-api-key
ASR_BASE_URL=
ASR_MODEL=qwen-audio-3.0-asr-flash-streaming

# 语音合成：qwen-audio-3.0-tts-plus，走 dashscope SDK，支持情绪指令（比如"用轻快的语气说"）
# TTS_VOICE 是音色名，联调时从官方音色表挑一个填，留空先用默认音色
TTS_API_KEY=your-dashscope-api-key
TTS_BASE_URL=
TTS_MODEL=qwen-audio-3.0-tts-plus
TTS_VOICE=

# Realtime 实时语音：一条线直连 qwen3.5-omni-plus-realtime（识别+对话+合成一体）
# REALTIME_API_KEY 留空就按 REALTIME_API_KEY -> TTS_API_KEY -> LLM_API_KEY 的顺序借钥匙，
# 但注意：这把 key 必须是能开通 Realtime 模型的百炼 key（代理转发类的 key 连不上）
# REALTIME_VOICE 是默认音色（当前 Maia），想换自定义音色改这里，运行中也能切
# REALTIME_WORKSPACE_ID 是业务空间 ID，留空走通用域名；填了走业务空间专属域名更快
REALTIME_API_KEY=
REALTIME_MODEL=qwen3.5-omni-plus-realtime
REALTIME_VOICE=Maia
REALTIME_WORKSPACE_ID=

# 天气：用 Open-Meteo，免费不要 key，这行留空也能跑
WEATHER_API_KEY=

# 联网搜索：用 ddgs（DuckDuckGo），也不要 key，留空即可
SEARCH_API_KEY=

# 图片生成：qwen-image-3.0-pro，走 dashscope 异步任务（提交任务+轮询取图）
IMAGE_GEN_API_KEY=your-dashscope-api-key
IMAGE_GEN_MODEL=qwen-image-3.0-pro

# 向量模型：qwen3-vl-embedding，走 dashscope 原生接口（它不支持 OpenAI 兼容接口）
# 维度默认 2560；改维度等于换坐标系，Chroma 集合要重建，别乱动
EMBEDDING_API_KEY=your-dashscope-api-key
EMBEDDING_MODEL=qwen3-vl-embedding
EMBEDDING_DIMENSION=2560

# 本地存储目录
DATA_DIR=./storage

# HTTPS 证书的额外域名 SAN（可选）：把你的公网域名加进自签证书，
# 多个用逗号分隔；只用 IP/localhost 访问就留空
HTTPS_PUBLIC_DOMAINS=

# 监听地址：默认 0.0.0.0 = 对外可访问（手机走局域网 IP 访问需要它）；
# 只想本机使用就改成 127.0.0.1，局域网/公网都连不上。
BIND_HOST=0.0.0.0

# 访问口令：公网部署必配！配置后所有接口/语音通道要求口令（浏览器会弹框输入一次）。
# 本机/内网自用可留空（不鉴权）；留空且对外监听时会启动时自动生成一个随机口令写入本文件
ACCESS_TOKEN=
